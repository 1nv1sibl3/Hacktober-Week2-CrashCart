# CrashCart configuration
# Copy to .env.local and fill in only the providers you use.
# NEVER commit real keys. NEVER prefix a secret with NEXT_PUBLIC_.

# ---------- Core ----------
# Default selection in the model picker. Keep this an open-weight model for the contest demo.
CRASHCART_DEFAULT_PROVIDER=google
CRASHCART_DEFAULT_MODEL=gemma-4-26b-a4b-it
# Maximum characters of log accepted per analysis.
CRASHCART_MAX_INPUT_CHARS=30000
# Per-call provider timeout in milliseconds.
CRASHCART_PROVIDER_TIMEOUT_MS=45000
# Best-effort per-IP limits (in-memory, per server instance).
CRASHCART_RATE_LIMIT_PER_MINUTE=5
CRASHCART_RATE_LIMIT_PER_DAY=40

# ---------- Google AI Studio (Gemini API) ----------
# Get a key at https://aistudio.google.com/apikey
# Gemma 4 is open-weight (Apache-2.0). On the Gemini API it is free-tier only,
# and Google may use free-tier data to improve its products.
GEMINI_API_KEY=
# gemma-4-31b-it is also listed by the API but returned HTTP 500 on every call in
# Phase 0 testing (see docs/TESTING.md). Add it back only after a re-test passes.
GOOGLE_GEMMA_MODELS=gemma-4-26b-a4b-it
# Optional proprietary Gemini models, comma-separated.
GOOGLE_GEMINI_MODELS=
# Native JSON mode (responseMimeType=application/json): on | off.
# Verified with gemma-4-26b-a4b-it in Phase 0. The app still parses prompt-only JSON when off.
GOOGLE_JSON_MODE=on
# Gemma 4 thinks by default, which took up to 64 s per diagnosis in testing.
# MINIMAL disables it (~4.5x faster, same diagnosis quality). Empty = API default.
GOOGLE_THINKING_LEVEL=MINIMAL

# ---------- Ollama, local (OpenAI-compatible) ----------
# Runs Gemma on your own machine so logs never leave it.
# Not reachable from a hosted deployment. Example: http://localhost:11434/v1
OLLAMA_BASE_URL=
# Example: gemma4:e4b
OLLAMA_MODELS=
# true if your Ollama version supports response_format={"type":"json_object"}
OLLAMA_JSON_MODE=false

# ---------- xAI Grok (OpenAI-compatible, proprietary) ----------
# Verify the base URL and model IDs against xAI's current docs.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODELS=
XAI_JSON_MODE=false

# ---------- Custom OpenAI-compatible provider ----------
CUSTOM_OPENAI_LABEL=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODELS=
# true only if every model listed above is open-weight
CUSTOM_OPENAI_OPEN_WEIGHT=false
# true only if the provider supports response_format={"type":"json_object"}
CUSTOM_OPENAI_JSON_MODE=false
